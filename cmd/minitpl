#!/usr/bin/env php
<?php

/*
 * minitpl - command line for the MiniTPL template engine.
 *
 * The compiler turns every {tag} of a template into php at build time. This
 * command runs that step on a directory, and renders a template with data
 * read from yaml, so a project can use MiniTPL without writing a php script
 * for either.
 *
 * Tit Petric <black@titpetric.com>, MIT license, see LICENSE.
 */

namespace MiniTPL\Cli;

use MiniTPL\Compiler;
use MiniTPL\Template;
use MiniTPL\Yaml;

\define("MINITPL_USAGE", <<<'TEXT'
minitpl - compile and render MiniTPL templates

Usage:
  minitpl compile [options] [templates_dir] [output_dir]
  minitpl render  [options] <template.tpl> [data.yml]
  minitpl help

compile
  Transpiles every .tpl file under templates_dir (default: templates) into
  output_dir, which defaults to the templates_c directory beside
  templates_dir. Subdirectories keep their names, and {include} is resolved
  against templates_dir.

render
  Renders template.tpl to standard output. Template variables come from a
  yaml mapping read from data.yml, or from standard input when it is a file
  or a pipe; pass - to read standard input explicitly.

Options:
  -o, --output DIR  write compiled templates to DIR (compile)
  -q, --quiet       print nothing but errors
  -h, --help        show this help
TEXT
);

// When installed with composer, the bin proxy provides the autoloader. A
// checkout of the repository has one too, after composer install; without
// either, the four files the command needs are loaded directly.
if (isset($_composer_autoload_path)) {
	require_once $_composer_autoload_path;
} elseif (file_exists(__DIR__ . "/../vendor/autoload.php")) {
	require_once __DIR__ . "/../vendor/autoload.php";
} elseif (file_exists(__DIR__ . "/../../../autoload.php")) {
	require_once __DIR__ . "/../../../autoload.php";
} else {
	require_once __DIR__ . "/../code/MiniTPL/Hook.php";
	require_once __DIR__ . "/../code/MiniTPL/Compiler.php";
	require_once __DIR__ . "/../code/MiniTPL/Template.php";
	require_once __DIR__ . "/../code/MiniTPL/Yaml.php";
}

/** Run the command line and return the exit status */
function main(array $argv) {
	$args = array_slice($argv, 1);
	if (count($args) === 0) {
		fwrite(STDERR, MINITPL_USAGE . "\n");
		return 1;
	}

	$command = array_shift($args);
	switch ($command) {
		case "compile":
			return command_compile($args);
		case "render":
			return command_render($args);
		case "help":
		case "-h":
		case "--help":
			fwrite(STDOUT, MINITPL_USAGE . "\n");
			return 0;
	}

	fwrite(STDERR, "minitpl: unknown command '" . $command . "'\n\n" . MINITPL_USAGE . "\n");
	return 1;
}

/** minitpl compile [options] [templates_dir] [output_dir] */
function command_compile(array $args) {
	list($options, $positional) = parse_options($args);

	if (!empty($options["help"])) {
		fwrite(STDOUT, MINITPL_USAGE . "\n");
		return 0;
	}

	$source = isset($positional[0]) ? $positional[0] : "templates";
	if (!is_dir($source)) {
		throw new \RuntimeException("templates directory '" . $source . "' does not exist");
	}

	if (isset($options["output"])) {
		$output = $options["output"];
	} elseif (isset($positional[1])) {
		$output = $positional[1];
	} else {
		$output = compiled_dir($source);
	}

	$source = rtrim($source, "/");
	if ($source === "") {
		$source = "/";
	}

	$output = rtrim($output, "/");
	if ($output === "") {
		$output = "/";
	}

	$files = find_templates($source);
	$compiler = new Compiler();
	$find_path = function ($name) use ($source) {
		return file_exists($source . "/" . $name) ? $source . "/" : false;
	};

	$compiled = 0;
	$failed = 0;
	foreach ($files as $file) {
		$relative = substr($file, strlen($source) + 1);
		$destination = $output . "/" . $relative;

		if ($compiler->compile($file, $destination, $find_path, false)) {
			$compiled++;
			if (empty($options["quiet"])) {
				echo $file . " -> " . $destination . "\n";
			}
		} else {
			$failed++;
			fwrite(STDERR, "minitpl: failed to compile '" . $file . "'\n");
		}
	}

	if (empty($options["quiet"])) {
		echo "compiled " . $compiled . " template" . (($compiled === 1) ? "" : "s") . " into " . $output . "\n";
	}

	return $failed > 0 ? 1 : 0;
}

/** minitpl render [options] <template.tpl> [data.yml] */
function command_render(array $args) {
	list($options, $positional) = parse_options($args);

	if (!empty($options["help"])) {
		fwrite(STDOUT, MINITPL_USAGE . "\n");
		return 0;
	}

	if (count($positional) === 0) {
		throw new \RuntimeException("render needs a template file");
	}

	if (count($positional) > 2) {
		throw new \RuntimeException("render takes at most a template file and a data file");
	}

	$template = $positional[0];
	$data_file = isset($positional[1]) ? $positional[1] : null;

	if (!is_file($template)) {
		throw new \RuntimeException("template file '" . $template . "' does not exist");
	}

	$data = array();
	if ($data_file !== null && $data_file !== "-") {
		$data = Yaml::parse_file($data_file);
	} elseif ($data_file === "-" || !stdin_is_tty()) {
		$yaml = stream_get_contents(STDIN);
		if ($yaml !== false && trim($yaml) !== "") {
			$data = Yaml::parse($yaml);
		}
	}

	if ($data === null) {
		$data = array();
	}

	// assign() takes a mapping of variable names. A top level yaml sequence
	// parses to a list, which is not one.
	if (!is_array($data) || (count($data) > 0 && is_list($data))) {
		throw new \RuntimeException("template data has to be a yaml mapping");
	}

	$dir = dirname($template);
	$path = ($dir === "." || $dir === "") ? "./" : rtrim($dir, "/") . "/";

	$tpl = new Template();
	$tpl->set_paths($path);

	// load() resets the variables assigned before it, so the data goes in after.
	if (!$tpl->load(basename($template))) {
		throw new \RuntimeException("template file '" . $template . "' could not be compiled");
	}

	$tpl->assign($data);
	$tpl->render();
	return 0;
}

/** Split arguments into options and positional values */
function parse_options(array $args) {
	$options = array();
	$positional = array();
	$length = count($args);

	for ($i = 0; $i < $length; $i++) {
		$arg = $args[$i];

		if ($arg === "--") {
			for ($i++; $i < $length; $i++) {
				$positional[] = $args[$i];
			}

			break;
		}

		if ($arg === "-o" || $arg === "--output") {
			if ($i + 1 >= $length) {
				throw new \RuntimeException($arg . " needs a directory");
			}

			$options["output"] = $args[++$i];
			continue;
		}

		if (substr($arg, 0, 9) === "--output=") {
			$options["output"] = substr($arg, 9);
			continue;
		}

		if ($arg === "-q" || $arg === "--quiet") {
			$options["quiet"] = true;
			continue;
		}

		if ($arg === "-h" || $arg === "--help") {
			$options["help"] = true;
			continue;
		}

		if ($arg !== "-" && substr($arg, 0, 1) === "-") {
			throw new \RuntimeException("unknown option '" . $arg . "'");
		}

		$positional[] = $arg;
	}

	return array($options, $positional);
}

/** Whether an array is a list with indices 0..n */
function is_list(array $data) {
	$index = 0;
	foreach ($data as $key => $value) {
		if ($key !== $index++) {
			return false;
		}
	}

	return true;
}

/** The compiled directory that belongs to a template directory */
function compiled_dir($dir) {
	$template = new Template();
	$path = rtrim($dir, "/") . "/";
	$template->set_paths($path);

	return rtrim($template->_compile_path($path), "/");
}

/** Every .tpl file under a directory, oldest name first */
function find_templates($dir) {
	$found = array();
	$entries = @scandir($dir);
	if ($entries === false) {
		throw new \RuntimeException("unable to read directory '" . $dir . "'");
	}

	sort($entries);
	foreach ($entries as $entry) {
		if ($entry === "." || $entry === ".." || substr($entry, 0, 1) === ".") {
			continue;
		}

		$path = $dir . "/" . $entry;
		if (is_dir($path)) {
			$found = array_merge($found, find_templates($path));
		} elseif (substr($entry, -4) === ".tpl") {
			$found[] = $path;
		}
	}

	return $found;
}

/** Whether standard input is a terminal, where reading it would wait */
function stdin_is_tty() {
	if (!defined("STDIN")) {
		return false;
	}

	if (function_exists("stream_isatty")) {
		return @stream_isatty(STDIN);
	}

	if (function_exists("posix_isatty")) {
		return @posix_isatty(STDIN);
	}

	return false;
}

try {
	$status = main($argv);
} catch (\Exception $e) {
	fwrite(STDERR, "minitpl: " . $e->getMessage() . "\n");
	$status = 1;
}

exit($status);
